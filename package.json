{
	"name": "chat-widget",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "pnpm build:widget && next dev",
		"build": "pnpm build:widget && next build",
		"build:widget": "tailwindcss -i widget/styles.css -o public/widget.css --minify && node scripts/build-widget.mjs",
		"start": "next start",
		"check": "biome ci .",
		"format": "biome check --write .",
		"lint": "biome check . && eslint",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:browser": "playwright test",
		"ingest": "tsx scripts/ingest-anssi.ts",
		"verify:corpus": "tsx scripts/verify-corpus.ts"
	},
	"dependencies": {
		"@assistant-ui/react": "0.15.28",
		"@codegouvfr/react-dsfr": "^1.36.0",
		"next": "16.4.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@playwright/test": "1.64.1",
		"@tailwindcss/cli": "4.3.3",
		"@tailwindcss/turbopack": "4.3.3",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"cve-lite-cli": "1.39.0",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-config-next": "16.4.1",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"vitest": "5.0.4"
	},
	"packageManager": "pnpm@11.18.0",
	"description": "Widget de chat RAG pour interroger le corpus ANSSI via l'API Albert (POC)"
}
